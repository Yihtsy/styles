<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="en-US" initialize-with=". ">
  <info>
    <title>现代外语（Original 字段版）</title>
    <id>http://www.zotero.org/styles/modern-foreign-languages-china-original-fields</id>
    <link href="http://www.zotero.org/styles/modern-foreign-languages-china-original-fields" rel="self"/>
    <author><name>Tsy Yih</name><email>yihtsy@outlook.com</email></author>
    <category citation-format="author-date"/><category field="linguistics"/><issn>1003-6105</issn>
    <summary>Original 字段版。格式证据：《现代外语》2024年第4期及2025年样刊；适用于已核验的2024—2025年版式，跨年度使用宜复核。英文或罗马化主著录读取普通字段，中文原文读取 Extra 的 original-* 字段并附于主著录后。</summary>
    <updated>2026-10-04T00:00:00+08:00</updated><rights license="http://creativecommons.org/licenses/by-sa/3.0/">CC BY-SA 3.0</rights>
  </info>
  <locale xml:lang="en"><terms><term name="page-range-delimiter">-</term><term name="et-al">et al.</term></terms></locale>
  <macro name="year"><date variable="issued"><date-part name="year"/></date></macro>
  <macro name="cite-author"><names variable="author"><name form="short" and="symbol" delimiter=", " delimiter-precedes-last="never"/><substitute><names variable="editor"/><text variable="title" form="short"/></substitute></names></macro>
  <macro name="author"><names variable="author"><name initialize-with=". " name-as-sort-order="first" sort-separator=", " delimiter=", " and="symbol" delimiter-precedes-last="never"/><substitute><names variable="editor"><name initialize-with=". " name-as-sort-order="first" sort-separator=", " delimiter=", " and="symbol" delimiter-precedes-last="never"/><label form="short" prefix=" (" suffix=")"/></names><text variable="title"/></substitute></names></macro>
  <macro name="original-author"><choose><if variable="original-author"><names variable="original-author" prefix=" (" suffix=")"><name initialize="false" name-as-sort-order="all" sort-separator="" delimiter="、"/></names></if></choose></macro>
  <macro name="volume-issue"><choose><if variable="volume"><text variable="volume" prefix=" "/><text variable="issue" prefix="(" suffix=")"/></if><else><text variable="issue" prefix=" (" suffix=")"/></else></choose><text variable="page" prefix=": "/></macro>
  <macro name="editors"><names variable="editor"><name initialize-with=". " delimiter=", " and="symbol" delimiter-precedes-last="never"/><label form="short" prefix=" (" suffix=")"/></names></macro>
  <macro name="edition"><choose><if is-numeric="edition"><number variable="edition" form="ordinal" suffix=" edn"/></if><else><text variable="edition"/></else></choose></macro>
  <macro name="publisher"><group delimiter=": "><text variable="publisher-place"/><text variable="publisher"/></group></macro>
  <macro name="main-source"><choose>
    <if type="article-journal article-magazine article-newspaper" match="any"><text variable="title" suffix=". "/><text variable="container-title" font-style="italic"/><text macro="volume-issue"/></if>
    <else-if type="chapter entry-dictionary entry-encyclopedia paper-conference" match="any"><text variable="title" suffix=". "/><choose><if variable="editor"><text value="In "/><text macro="editors"/><text variable="container-title" font-style="italic" prefix=". "/></if><else><text variable="container-title" font-style="italic"/></else></choose><text macro="publisher" prefix=". "/><text variable="page" prefix=", "/></else-if>
    <else-if type="book graphic map motion_picture musical_score pamphlet report song speech" match="any"><text variable="title" font-style="italic"/><text macro="edition" prefix=" (" suffix=")"/><text macro="publisher" prefix=". "/></else-if>
    <else-if type="thesis"><text variable="title" font-style="italic"/><text variable="genre" prefix=". "/><text variable="publisher" prefix=", "/></else-if>
    <else><text variable="title"/><text variable="container-title" prefix=". "/><text macro="publisher" prefix=". "/><text variable="URL" prefix=". "/></else>
  </choose></macro>
  <macro name="original-block"><choose><if variable="original-title original-container-title" match="any"><group prefix=" [" suffix=".]"><text macro="year" suffix=", "/><text variable="original-title" suffix=". "/><text variable="original-container-title" prefix="《" suffix="》"/><text variable="issue" prefix="第" suffix="期"/><text variable="page" prefix=": "/></group></if></choose></macro>
  <macro name="entry"><text macro="author"/><text macro="original-author"/><text macro="year" prefix=". " suffix=". "/><text macro="main-source"/><text macro="original-block"/></macro>
  <citation et-al-min="3" et-al-use-first="1" disambiguate-add-year-suffix="true"><sort><key macro="year"/><key macro="cite-author"/></sort><layout prefix="(" suffix=")" delimiter="; "><group delimiter=" "><text macro="cite-author"/><text macro="year"/><text variable="locator" prefix=": "/></group></layout></citation>
  <bibliography hanging-indent="true" entry-spacing="0" et-al-min="6" et-al-use-first="3"><sort><key macro="author"/><key macro="year"/><key variable="title"/></sort><layout suffix="."><text macro="entry"/></layout></bibliography>
</style>
